{
  "name": "default",
  "allowedTools": ["shell"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "git log *",
        "git status",
        "git diff *",
        "git branch *",
        "git checkout *",
        "git add *",
        "git commit *",
        "git push origin feat/*",
        "git push origin fix/*",
        "git push origin docs/*",
        "git push origin chore/*",
        "git push origin refactor/*",
        "git fetch *",
        "git stash *",
        "npm *",
        "node *",
        "npx *",
        "make *",
        "find *",
        "ls *",
        "cat *",
        "mkdir *",
        "cp *",
        "mv *",
        "rm *",
        "curl *",
        "bash *",
        "echo *",
        "timeout *",
        "docker *",
        "terraform init *",
        "terraform plan *",
        "terraform validate *",
        "terraform fmt *",
        "terraform output *",
        "terraform show *",
        "terraform state list *",
        "terraform state show *",
        "aws s3 ls *",
        "aws s3 cp *",
        "aws s3api *",
        "aws cloudformation describe*",
        "aws cloudformation list*",
        "aws lambda get*",
        "aws lambda list*",
        "aws logs *",
        "aws ec2 describe*",
        "aws iam list*",
        "aws iam get*",
        "aws sts get-caller-identity",
        "gcloud info",
        "gcloud config *",
        "gcloud projects list",
        "gcloud projects describe *",
        "gcloud compute instances list *",
        "gcloud compute instances describe *",
        "gcloud functions list *",
        "gcloud functions describe *",
        "gcloud run services list *",
        "gcloud run services describe *",
        "gcloud storage ls *",
        "gcloud logging read *",
        "gcloud iam list*",
        "gh issue *",
        "gh pr *",
        "gh repo view *",
        "gh run *",
        "gh release list *"
      ]
    }
  },
  "includeMcpJson": true
}
